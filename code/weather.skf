// Подключаем Python-мост для работы с HTTP и JSON
пусть requests = подключить_питон("requests")
пусть json = подключить_питон("json")

// Базовый URL API open-meteo
пусть БАЗОВЫЙ_URL = "https://api.open-meteo.com/v1/forecast"

функция получить_погоду(широта, долгота) {
    // Формируем параметры запроса
    пусть параметры = {
        "latitude": широта,
        "longitude": долгота,
        "current": "temperature_2m,wind_speed_10m",
        "timezone": "auto"
    }

    // Выполняем HTTP GET запрос
    пусть ответ = requests.get(БАЗОВЫЙ_URL, params=параметры)
    
    // Проверяем статус ответа
    если ответ.status_code != 200 {
        бросить "Ошибка API: статус " + ответ.status_code
    }

    // Парсим JSON
    пусть данные = ответ.json()
    
    // Извлекаем текущую погоду
    пусть текущая = данные["current"]
    
    вернуть {
        "температура": текущая["temperature_2m"],
        "ветер": текущая["wind_speed_10m"],
        "время": текущая["time"]
    }
}

// Дополнительная функция для получения прогноза на несколько дней
функция получить_прогноз(широта, долгота, дней = 3) {
    пусть параметры = {
        "latitude": широта,
        "longitude": долгота,
        "daily": "temperature_2m_max,temperature_2m_min,weathercode",
        "timezone": "auto",
        "forecast_days": дней
    }

    пусть ответ = requests.get(БАЗОВЫЙ_URL, params=параметры)
    
    если ответ.status_code != 200 {
        бросить "Ошибка API: статус " + ответ.status_code
    }

    пусть данные = ответ.json()
    пусть ежедневно = данные["daily"]
    
    // Собираем прогноз в список словарей
    пусть прогноз = []
    пусть i = 0
    пока i < длина(ежедневно["time"]) {
        прогноз.добавить({
            "дата": ежедневно["time"][i],
            "макс_темп": ежедневно["temperature_2m_max"][i],
            "мин_темп": ежедневно["temperature_2m_min"][i],
            "код_погоды": ежедневно["weathercode"][i]
        })
        i = i + 1
    }
    
    вернуть прогноз
}
