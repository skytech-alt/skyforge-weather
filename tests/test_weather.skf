// Подтягиваем наш пакет (ключевое слово для импорта в SkyForge)
пусть weather = подтянуть "weather"

@тест("Получение текущей погоды для Берлина")
функция тест_берлин() {
    // Берлин: 52.52, 13.41
    пусть результат = weather.получить_погоду(52.52, 13.41)
    
    // Проверяем, что вернулся словарь с нужными полями
    ожидать_равно(тип(результат), "словарь")
    ожидать_истина(содержит(результат, "температура"))
    ожидать_истина(содержит(результат, "ветер"))
    ожидать_истина(содержит(результат, "время"))
    
    // Температура должна быть числом
    ожидать_равно(тип(результат["температура"]), "число")
}

@тест("Ошибка при неверных координатах")
функция тест_ошибка() {
    // Широта вне допустимого диапазона (-90..90)
    пусть ошибка = ""
    попробовать {
        weather.получить_погоду(999, 999)
    } поймать(е) {
        ошибка = е
    }
    // Ожидаем, что функция выбросит ошибку
    ожидать_истина(длина(ошибка) > 0)
}

@тест("Прогноз возвращает список")
функция тест_прогноз() {
    пусть прогноз = weather.получить_прогноз(55.75, 37.62, 3) // Москва
    ожидать_равно(тип(прогноз), "список")
    ожидать_равно(длина(прогноз), 3)
}
